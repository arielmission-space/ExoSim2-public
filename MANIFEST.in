# The sdist must stay lean: setuptools-scm would otherwise pull in every
# git-tracked file (test fixtures, docs assets, notebooks -> tens of MB).

graft src/exosim
include README.md LICENSE CHANGELOG.rst CITATION.cff codemeta.json
include pyproject.toml

prune tests
prune test_suite
# docs and examples: only what the MCP server ships (see src/exosim/mcp/assets.py,
# which copies them into the wheel at build time); no images, notebooks or big data.
prune docs
prune examples
include AGENTS.md
include docs/ai-agents/*.md
recursive-include docs/source *.rst
recursive-include examples *.xml *.csv *.ecsv *.h5 *.py *.yaml *.yml *.txt
exclude examples/customsed.csv
exclude docs/ai-agents/mcp-hardening-roadmap.md
exclude docs/ai-agents/mcp-recipe-metadata.md
exclude docs/ai-agents/mcp-release-plan.md
prune .github
prune changelog.d
prune .benchmarks

exclude noxfile.py run_tests.py setup.cfg pyrightconfig.json
exclude uv.lock coverage.yml coverage.xml codecov
exclude .pre-commit-config.yaml .readthedocs.yaml .python-version .flake8
exclude .bumpversion.cfg .secrets.baseline .buildinfo .nojekyll
exclude src/exosim/_version.py

global-exclude *.py[cod] __pycache__ *.so *.dylib
global-exclude .DS_Store *.swp *~
